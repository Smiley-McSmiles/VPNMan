#compdef vpnman
# zsh completion for vpnman - generated by tools/gen_completions.py, do not edit

_vpnman_profiles() {
    local -a names
    names=("${(@f)$(vpnman list --names 2>/dev/null)}")
    _describe 'profile' names
}

_vpnman() {
    local -a commands
    commands=(
        'about:credits, license and ways to support the project'
        'add:create a profile without a config file'
        'autostart:connect the VPN automatically when the system starts'
        'backup:export or restore all profiles (with credentials) and settings'
        'block:blacklist'
        'blocks:addresses, ports and programs that may not use the network'
        'bypass:apps that skip the VPN (split tunnel)'
        'cleanup:remove firewall rules, routes and cgroups VPNMan left behind (root)'
        'connect:connect to a profile'
        'connections:live list of connections - which application, port and protocol'
        'daemon:run the daemon in the foreground (root)'
        'disconnect:disconnect'
        'dns:choose the DNS servers used while connected'
        'doctor:check the system (icons, daemon, protocols)'
        'down:disconnect'
        'edit:change profile fields'
        'failover:servers to try, in order, when a profile keeps failing'
        'fav:mark favourite'
        'get:show settings'
        'group:list groups; rename a group or edit all its servers at once'
        'gui:open the GTK4/libadwaita app'
        'history:recent connections - when, how long, how much traffic'
        'import:import config files or a directory of them'
        'leaktest:check the live connection - tunnel, public IP, kill switch, DNS and IPv6 leaks'
        'list:list profiles'
        'lock:network lock (kill switch)'
        'logs:show daemon log'
        'ls:list profiles'
        'menu:interactive menu'
        'netproxy:a proxy server all traffic goes through (after the VPN while one is connected)'
        'networks:show the current network; trust/untrust it'
        'ping:measure latency to profiles'
        'protocols:list supported protocols and whether their tools are installed'
        'proxy:proxies (Xray - VLESS, VMess, Trojan, Shadowsocks) in front of, or behind, the VPN'
        'remove:delete profiles'
        'rm:delete profiles'
        'routes:addresses, networks or domains that skip the VPN'
        'schedule:connect the VPN at set times'
        'service:install/control the background service'
        'set:change a setting'
        'shell:interactive menu'
        'split:apps that skip the VPN (split tunnel)'
        'status:show connection status'
        'unblock:remove from blacklist'
        'unfav:unmark favourite'
        'up:connect to a profile'
        'update:check GitHub for a newer VPNMan release (exit 10 if there is one)'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi
    case $words[2] in
        about) _arguments '*:: :' ;;
        add) _arguments '--protocol[VPN protocol (see: vpnman protocols)]:value:(openvpn wireguard amneziawg openconnect openfortivpn ikev2 sstp pptp vpnc tailscale netbird zerotier nebula networkmanager custom)' '--server[server host name or address]' '--port[server port]' '--user[username]' '--ask-password[prompt for the password]' '(--option -o)'{--option,-o}'[protocol option (repeatable)]' ;;
        autostart) _arguments '--login-app[start the tray app at login (this user)]:value:(on off)' ;;
        backup) _arguments '--replace[import: make this computer match the backup (removes other profiles)]' '--settings[import: also restore the settings (always with --replace)]' '--force[export: overwrite an existing file]' '1:action:(export import)' ;;
        block) _arguments '*:profile:_vpnman_profiles' ;;
        blocks) _arguments '--proto[add: protocol (endpoint and port entries)]:value:(any tcp udp)' '--note[add: a reminder of why]' '--for[add: end the block after 30m, 2h, 1d... (minutes when there is no unit)]' '--until-reboot[add: end the block when the computer restarts]' '--json[print machine-readable JSON instead of text]' '1:action:(list status add remove rm enable disable on off)' ;;
        bypass) _arguments '1:action:(list add remove rm available on off mode)' ;;
        cleanup) _arguments '--force[even if the service is running]' ;;
        connect) _arguments '--fastest[measure all servers and use the one with the lowest latency]' '--last[use the last connected profile (the default without a profile)]' '--no-wait[return immediately instead of waiting for the tunnel]' '--timeout[how long to wait (default 90)]' '*:profile:_vpnman_profiles' ;;
        connections) _arguments '(--listening -l)'{--listening,-l}'[also show sockets that wait for connections]' '--local[also show connections within this computer (loopback)]' '(--resolve -r)'{--resolve,-r}'[show host names instead of addresses where reverse DNS knows them (sends DNS queries)]' '(--watch -w)'{--watch,-w}'[refresh every 2 seconds]' '--csv[print CSV with a header line (for spreadsheets)]' '--json[print machine-readable JSON instead of text]' ;;
        daemon) _arguments '*:: :' ;;
        disconnect) _arguments '*:: :' ;;
        dns) _arguments '*:: :' ;;
        doctor) _arguments '--fix[link launcher/icons into /usr/share and rebuild icon caches (root)]' ;;
        down) _arguments '*:: :' ;;
        edit) _arguments '*:profile:_vpnman_profiles' ;;
        failover) _arguments '--clear[remove the list]' '*:profile:_vpnman_profiles' ;;
        fav) _arguments '*:profile:_vpnman_profiles' ;;
        get) _arguments '*:: :' ;;
        group) _arguments '--ask-password[prompt for a new password for all of them]' '1:action:(list edit)' ;;
        gui) _arguments '--background[start minimised to the system tray]' ;;
        history) _arguments '(-n --lines)'{-n,--lines}'[how many entries to show (default 20)]' '--json[print machine-readable JSON instead of text]' '--clear[delete the history]' ;;
        import) _arguments '--name[profile name (default: the file name; only with a single file)]' '--protocol[skip detection and use this protocol]:value:(openvpn wireguard amneziawg openconnect openfortivpn ikev2 sstp pptp vpnc tailscale netbird zerotier nebula networkmanager custom)' '--user[username to store with the profile]' '--password[password to store (visible in the process list - prefer --ask-password)]' '--ask-password[prompt for the password instead of putting it on the command line]' '--stunnel[carry OpenVPN over TLS via stunnel (default port 443)]' '--stunnel-sni[TLS server name to present (SNI)]' '--stunnel-ca[CA certificate to verify the stunnel server with]' '--stunnel-verify[how to verify the stunnel server]:value:(none system ca)' ;;
        leaktest) _arguments '--json[print machine-readable JSON instead of text]' ;;
        list) _arguments '(--latency -l)'{--latency,-l}'[measure and show the latency of every server]' '--names[one profile name per line (used by shell completion)]' '--sort[sort order (latency implies --latency)]:value:(name latency group)' '--json[print machine-readable JSON instead of text]' ;;
        lock) _arguments '1:action:(on off status)' ;;
        logs) _arguments '(-f --follow)'{-f,--follow}'[keep running and print new lines]' '(-n --lines)'{-n,--lines}'[how many lines to show first (default 50)]' ;;
        ls) _arguments '(--latency -l)'{--latency,-l}'[measure and show the latency of every server]' '--names[one profile name per line (used by shell completion)]' '--sort[sort order (latency implies --latency)]:value:(name latency group)' '--json[print machine-readable JSON instead of text]' ;;
        menu) _arguments '*:: :' ;;
        netproxy) _arguments '--user[set: user name for a proxy that needs a login]' '--ask-password[set: ask for the proxy'\''s password]' '--json[print machine-readable JSON instead of text]' '1:action:(status on off set clear ignore apps dns udp)' ;;
        networks) _arguments '1:action:(show trust untrust)' ;;
        ping) _arguments '*:profile:_vpnman_profiles' ;;
        protocols) _arguments '--json[print machine-readable JSON instead of text]' ;;
        proxy) _arguments '--name[add: name for a single imported proxy]' '--group[add: group to put the imported proxies in (default: the subscription'\''s host); list, remove, use --fastest: only this group]' '--all[remove: every proxy]' '--fastest[use: the proxy with the quickest server]' '--qr[link: also print a QR code]' '(--latency -l)'{--latency,-l}'[list: measure every server]' '--json[print machine-readable JSON instead of text]' '1:action:(list show link add remove rm edit use on off order mode set status ping refresh sources failover)' ;;
        remove) _arguments '*:profile:_vpnman_profiles' ;;
        rm) _arguments '*:profile:_vpnman_profiles' ;;
        routes) _arguments '1:action:(list add remove rm)' ;;
        schedule) _arguments '--name[label for the schedule]' '--days[all | weekdays | weekends | mon,wed | mon-fri  (default: all)]' '--start[connect at this time (24-hour clock)]' '--end[disconnect again at this time]' '--profile[profile name/id, '\''fastest'\'' or '\''last'\'' (default: last used)]' '1:action:(list add remove rm enable disable on off)' ;;
        service) _arguments '--init[force the init system instead of auto-detecting it]:value:(systemd runit openrc sysv openbsd-rc bsd-rc)' '1:action:(install uninstall enable disable start stop restart status)' ;;
        set) _arguments '*:: :' ;;
        shell) _arguments '*:: :' ;;
        split) _arguments '1:action:(list add remove rm available on off mode)' ;;
        status) _arguments '--json[print machine-readable JSON instead of text]' ;;
        unblock) _arguments '*:profile:_vpnman_profiles' ;;
        unfav) _arguments '*:profile:_vpnman_profiles' ;;
        up) _arguments '--fastest[measure all servers and use the one with the lowest latency]' '--last[use the last connected profile (the default without a profile)]' '--no-wait[return immediately instead of waiting for the tunnel]' '--timeout[how long to wait (default 90)]' '*:profile:_vpnman_profiles' ;;
        update) _arguments '--json[print machine-readable JSON instead of text]' ;;
    esac
}

_vpnman "$@"
