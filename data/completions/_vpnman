#compdef vpnman
# zsh completion for vpnman - generated by tools/gen_completions.py, do not edit

_vpnman_profiles() {
    local -a names
    names=("${(@f)$(vpnman list --names 2>/dev/null)}")
    _describe 'profile' names
}

_vpnman() {
    local -a commands
    commands=(
        'about:credits, license and ways to support the project'
        'add:create a profile without a config file'
        'autostart:connect the VPN automatically when the system starts'
        'backup:export or restore all profiles (with credentials) and settings'
        'block:blacklist'
        'bypass:apps that skip the VPN (split tunnel) - list|add|remove|available|on|off|mode'
        'cleanup:remove firewall rules, routes and cgroups VPNMan left behind (root)'
        'connect:connect to a profile'
        'daemon:run the daemon in the foreground (root)'
        'disconnect:disconnect'
        'dns:choose the DNS servers used while connected'
        'doctor:check the system (icons, daemon, protocols)'
        'down:disconnect'
        'edit:change profile fields (name, username, password, server, port, dns, notes, group, stunnel=HOST -PORT|off, stunnel_sni, stunnel_ca=FILE, stunnel_verify)'
        'failover:servers to try, in order, when a profile keeps failing'
        'fav:mark favourite'
        'get:show settings'
        'gui:open the GTK4/libadwaita app'
        'history:recent connections - when, how long, how much traffic'
        'import:import config files or a directory of them'
        'leaktest:check the live connection - tunnel, public IP, kill switch, DNS and IPv6 leaks'
        'list:list profiles'
        'lock:network lock (kill switch)'
        'logs:show daemon log'
        'ls:list profiles'
        'menu:interactive menu'
        'networks:show the current network; trust/untrust it (auto-connect on untrusted networks)'
        'ping:measure latency to profiles'
        'protocols:list supported protocols and whether their tools are installed'
        'remove:delete profiles'
        'rm:delete profiles'
        'routes:addresses, networks or domains that skip the VPN - list|add|remove'
        'schedule:connect the VPN at set times - list|add|remove|enable|disable|on|off'
        'service:install/control the background service'
        'set:change a setting'
        'shell:interactive menu'
        'split:apps that skip the VPN (split tunnel) - list|add|remove|available|on|off|mode'
        'status:show connection status'
        'unblock:remove from blacklist'
        'unfav:unmark favourite'
        'up:connect to a profile'
        'update:check GitHub for a newer VPNMan release (exit 10 if there is one)'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi
    case $words[2] in
        about) _arguments '*:: :' ;;
        add) _arguments '--protocol[]:value:(openvpn wireguard amneziawg openconnect openfortivpn ikev2 sstp pptp vpnc tailscale netbird zerotier nebula networkmanager custom)' '--server[]' '--port[]' '--user[]' '--ask-password[]' '(--option -o)'{--option,-o}'[]' ;;
        autostart) _arguments '--login-app[start the tray app at login (this user)]:value:(on off)' ;;
        backup) _arguments '--replace[import: make this computer match the backup]' '--settings[import: also restore the settings (always with --replace)]' '--force[export: overwrite an existing file]' '1:action:(export import)' ;;
        block) _arguments '*:profile:_vpnman_profiles' ;;
        bypass) _arguments '*:: :' ;;
        cleanup) _arguments '--force[even if the service is running]' ;;
        connect) _arguments '--fastest[]' '--last[]' '--no-wait[]' '--timeout[]' '*:profile:_vpnman_profiles' ;;
        daemon) _arguments '*:: :' ;;
        disconnect) _arguments '*:: :' ;;
        dns) _arguments '*:: :' ;;
        doctor) _arguments '--fix[link launcher/icons into /usr/share and rebuild icon caches (root)]' ;;
        down) _arguments '*:: :' ;;
        edit) _arguments '*:profile:_vpnman_profiles' ;;
        failover) _arguments '--clear[remove the list]' '*:profile:_vpnman_profiles' ;;
        fav) _arguments '*:profile:_vpnman_profiles' ;;
        get) _arguments '*:: :' ;;
        gui) _arguments '--background[start minimised to the system tray]' ;;
        history) _arguments '(-n --lines)'{-n,--lines}'[]' '--json[]' '--clear[]' ;;
        import) _arguments '--name[]' '--protocol[]:value:(openvpn wireguard amneziawg openconnect openfortivpn ikev2 sstp pptp vpnc tailscale netbird zerotier nebula networkmanager custom)' '--user[]' '--password[]' '--ask-password[]' '--stunnel[carry OpenVPN over TLS via stunnel (default port 443)]' '--stunnel-sni[]' '--stunnel-ca[]' '--stunnel-verify[]:value:(none system ca)' ;;
        leaktest) _arguments '--json[]' ;;
        list) _arguments '(--latency -l)'{--latency,-l}'[]' '--names[one profile name per line (used by shell completion)]' '--sort[sort order (latency implies --latency)]:value:(name latency group)' '--json[]' ;;
        lock) _arguments '1:action:(on off status)' ;;
        logs) _arguments '(-f --follow)'{-f,--follow}'[]' '(-n --lines)'{-n,--lines}'[]' ;;
        ls) _arguments '(--latency -l)'{--latency,-l}'[]' '--names[one profile name per line (used by shell completion)]' '--sort[sort order (latency implies --latency)]:value:(name latency group)' '--json[]' ;;
        menu) _arguments '*:: :' ;;
        networks) _arguments '1:action:(show trust untrust)' ;;
        ping) _arguments '*:profile:_vpnman_profiles' ;;
        protocols) _arguments '*:: :' ;;
        remove) _arguments '*:profile:_vpnman_profiles' ;;
        rm) _arguments '*:profile:_vpnman_profiles' ;;
        routes) _arguments '*:: :' ;;
        schedule) _arguments '--name[]' '--days[all | weekdays | weekends | mon,wed | mon-fri]' '--start[]' '--end[disconnect again at this time]' '--profile[profile name/id, '\''fastest'\'' or '\''last'\'' (default: last used)]' ;;
        service) _arguments '--init[force the init system instead of auto-detecting it]:value:(systemd runit openrc sysv openbsd-rc bsd-rc)' '1:action:(install uninstall enable disable start stop restart status)' ;;
        set) _arguments '*:: :' ;;
        shell) _arguments '*:: :' ;;
        split) _arguments '*:: :' ;;
        status) _arguments '--json[]' ;;
        unblock) _arguments '*:profile:_vpnman_profiles' ;;
        unfav) _arguments '*:profile:_vpnman_profiles' ;;
        up) _arguments '--fastest[]' '--last[]' '--no-wait[]' '--timeout[]' '*:profile:_vpnman_profiles' ;;
        update) _arguments '--json[]' ;;
    esac
}

_vpnman "$@"
